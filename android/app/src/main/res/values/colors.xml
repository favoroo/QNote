<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      启动窗口底色。取值与 App 浅色画布一致（AppSurfacePalette.legacyLight.canvas），
      避免 Flutter 首帧画出来之前先露出一块纯白。MainActivity 会在 onCreate 里按用户
      保存的背景设置覆盖它，这里只是没有偏好数据时的兜底。
    -->
    <color name="launch_background">#F9F9FF</color>
    <color name="widget_background">#F5F6FA</color>
    <color name="widget_border">#E2E4EB</color>
    <color name="widget_text_primary">#1C1C1E</color>
    <color name="widget_text_secondary">#8E8E93</color>
    <color name="widget_accent">#007AFF</color>
    <color name="widget_card_bg">#FFFFFF</color>
    <!--
      今日待办小组件专属的半透明 token：alpha 只能写进色值，故收口成具名资源，
      布局里不出现裸 hex。不与 bg_widget 共用的通用色混用，避免连带改到其他组件。
    -->
    <color name="widget_todo_surface">#CCFFFFFF</color>
    <color name="widget_todo_hairline">#14000000</color>
    <color name="widget_todo_count_bg">#1F007AFF</color>
    <color name="widget_todo_icon_bg">#12000000</color>
    <color name="widget_priority">#007AFF</color>
    <color name="widget_badge_text">#FFFFFFFF</color>
    <!--
      「问小Q」组件专属 token（深色版见 values-night/colors.xml）。
      整个组件是一颗纯色圆，只留圆底色与机器人色两个 token，矢量里不出现裸 hex。
    -->
    <color name="widget_ai_circle">#007AFF</color>
    <color name="widget_ai_robot">#FFFFFFFF</color>
    <color name="dialog_bg">#FFFFFF</color>
    <color name="dialog_text">#1C1C1E</color>
    <color name="dialog_input_bg">#F2F2F7</color>
</resources>
