<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      启动窗口底色。取值与 App 浅色画布一致（AppSurfacePalette.legacyLight.canvas），
      避免 Flutter 首帧画出来之前先露出一块纯白。MainActivity 会在 onCreate 里按用户
      保存的背景设置覆盖它，这里只是没有偏好数据时的兜底。
    -->
    <color name="launch_background">#F9F9FF</color>
    <color name="widget_background">#F5F6FA</color>
    <color name="widget_border">#E2E4EB</color>
    <color name="widget_text_primary">#1C1C1E</color>
    <color name="widget_text_secondary">#8E8E93</color>
    <color name="widget_accent">#007AFF</color>
    <color name="widget_card_bg">#FFFFFF</color>
    <!--
      今日待办小组件专属的半透明 token：alpha 只能写进色值，故收口成具名资源，
      布局里不出现裸 hex。不与 bg_widget 共用的通用色混用，避免连带改到其他组件。
    -->
    <color name="widget_todo_surface">#CCFFFFFF</color>
    <color name="widget_todo_hairline">#14000000</color>
    <color name="widget_todo_count_bg">#1F007AFF</color>
    <color name="widget_todo_icon_bg">#12000000</color>
    <color name="widget_priority">#007AFF</color>
    <color name="widget_badge_text">#FFFFFFFF</color>
    <!--
      「问小Q」组件专属 token（深色版见 values-night/colors.xml）。
      沿用极简曜石黑家族语言，深浅色桌面壁纸下均保持统一黑色质感与清晰轮廓。
    -->
    <color name="widget_ai_circle">#F2101013</color>
    <color name="widget_ai_border">#26FFFFFF</color>
    <color name="widget_ai_inner_disc">#1E2027</color>
    <color name="widget_ai_glyph">#F4F4F6</color>
    <!--
      快捷记录组件专属 token：极简曜石黑便当盒体系（深浅色主题下均保持统一黑色质感）。
    -->
    <color name="widget_qr_surface">#F2101013</color>
    <color name="widget_qr_border">#26FFFFFF</color>
    <color name="widget_qr_on_surface">#F4F4F6</color>
    <color name="widget_qr_on_primary">#111114</color>
    <color name="widget_qr_icon">#F0F0F3</color>
    <color name="widget_qr_tile_bg">#EB23252B</color>
    <color name="widget_qr_tile_border">#1EFFFFFF</color>
    <!--
      快捷记录弹窗（桌面组件点按后的原生浮层）：沿用组件同一套曜石黑 + 正圆语言。
      弹窗在深浅色下都保持黑色质感，因此这组 token 只放 values，不另做 night 变体。
      表面色全部不透明：壁纸或组件透出会直接压低正文对比度。
    -->
    <color name="widget_qr_dialog_surface">#101013</color>
    <color name="widget_qr_input_bg">#1A1B20</color>
    <color name="widget_qr_dialog_tool_bg">#23252B</color>
    <color name="widget_qr_input_border">#1FFFFFFF</color>
    <color name="widget_qr_ripple">#33FFFFFF</color>
    <color name="dialog_on_accent">#FFFFFFFF</color>
    <color name="dialog_bg">#FFFFFF</color>
    <color name="dialog_text">#1C1C1E</color>
    <color name="dialog_input_bg">#F2F2F7</color>
</resources>
