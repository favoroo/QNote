<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_ai_entry_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <ImageView
        android:id="@+id/ai_entry_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="问小Q"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_ai_entry" />

    <TextView
        android:id="@+id/ai_entry_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="问小Q"
        android:textColor="@color/widget_text_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ai_entry_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:text="随手提问、记录与整理"
        android:textColor="@color/widget_text_secondary"
        android:textSize="11sp" />
</LinearLayout>
