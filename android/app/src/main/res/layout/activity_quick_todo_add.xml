<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Main Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_dialog_card"
        android:orientation="vertical"
        android:padding="16dp"
        android:elevation="8dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="快速添加待办"
            android:textColor="@color/dialog_text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- 单行输入：textMultiLine 会把回车吞成换行导致 IME 动作失效，这里依赖回车做连续添加 -->
        <EditText
            android:id="@+id/edit_todo_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="46dp"
            android:background="@drawable/bg_dialog_input"
            android:gravity="center_vertical"
            android:hint="要做些什么呢..."
            android:textColor="@color/dialog_text"
            android:textColorHint="@color/widget_text_secondary"
            android:textSize="14sp"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:maxLines="1" />

        <!-- Actions -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/btn_dialog_cancel"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:layout_alignParentLeft="true"
                android:background="@drawable/bg_dialog_btn_secondary"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:text="取消"
                android:textColor="@color/widget_text_secondary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_dialog_add"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:layout_alignParentRight="true"
                android:background="@drawable/bg_dialog_btn_primary"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:text="添加"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </RelativeLayout>
    </LinearLayout>
</FrameLayout>
