<?xml version="1.0" encoding="utf-8"?>
<!--
  快捷记录 · 1 行高横条（2×1 ～ 4×1）：整条是一颗主色胶囊。
  只放一句「记一下」+ 右侧两颗半透明白圆（相册 / 相机）。不再放笔图标：
  整条本身就是输入入口，再摆一支笔是重复表达。
  2 列宽只有约 120dp，放不下按钮，provider 会把两颗按钮隐藏，只留提示。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_quick_record_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_qr_pill"
    android:contentDescription="@string/widget_quick_record_action">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="7dp">

        <TextView
            android:id="@+id/qr_bar_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="记一下"
            android:textColor="@color/widget_qr_on_accent"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/qr_bar_photo"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_widget_qr_scrim"
            android:contentDescription="选择相册图片"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_gallery_white" />

        <ImageButton
            android:id="@+id/qr_bar_camera"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_widget_qr_scrim"
            android:contentDescription="启动相机拍照"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_camera_white" />
    </LinearLayout>
</FrameLayout>