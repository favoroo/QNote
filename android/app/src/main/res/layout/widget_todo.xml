<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/todo_widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="今日待办"
            android:textColor="@color/widget_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true" />

        <TextView
            android:id="@+id/todo_widget_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="(0)"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp"
            android:layout_toRightOf="@id/todo_widget_title"
            android:layout_marginLeft="6dp"
            android:layout_centerVertical="true" />

        <!-- Refresh Todo Button -->
        <ImageButton
            android:id="@+id/btn_widget_todo_refresh"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_refresh"
            android:contentDescription="刷新待办"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:scaleType="centerInside" />
    </RelativeLayout>

    <!-- Todo Static List Container -->
    <LinearLayout
        android:id="@+id/todo_static_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Item 0 -->
        <LinearLayout
            android:id="@+id/todo_item_layout_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="6dp"
            android:paddingHorizontal="2dp"
            android:layout_marginBottom="4dp"
            android:visibility="gone">
            <ImageView
                android:id="@+id/todo_item_checkbox_0"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_checkbox_unchecked"
                android:contentDescription="标记完成"
                android:clickable="false"
                android:focusable="false" />
            <TextView
                android:id="@+id/todo_item_title_0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:textColor="@color/widget_text_primary"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end" />
            <ImageView
                android:id="@+id/todo_item_priority_0"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginLeft="6dp"
                android:src="@drawable/ic_checkbox_checked"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Item 1 -->
        <LinearLayout
            android:id="@+id/todo_item_layout_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="6dp"
            android:paddingHorizontal="2dp"
            android:layout_marginBottom="4dp"
            android:visibility="gone">
            <ImageView
                android:id="@+id/todo_item_checkbox_1"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_checkbox_unchecked"
                android:contentDescription="标记完成"
                android:clickable="false"
                android:focusable="false" />
            <TextView
                android:id="@+id/todo_item_title_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:textColor="@color/widget_text_primary"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end" />
            <ImageView
                android:id="@+id/todo_item_priority_1"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginLeft="6dp"
                android:src="@drawable/ic_checkbox_checked"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Item 2 -->
        <LinearLayout
            android:id="@+id/todo_item_layout_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="6dp"
            android:paddingHorizontal="2dp"
            android:layout_marginBottom="4dp"
            android:visibility="gone">
            <ImageView
                android:id="@+id/todo_item_checkbox_2"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_checkbox_unchecked"
                android:contentDescription="标记完成"
                android:clickable="false"
                android:focusable="false" />
            <TextView
                android:id="@+id/todo_item_title_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:textColor="@color/widget_text_primary"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end" />
            <ImageView
                android:id="@+id/todo_item_priority_2"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginLeft="6dp"
                android:src="@drawable/ic_checkbox_checked"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Item 3 -->
        <LinearLayout
            android:id="@+id/todo_item_layout_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="6dp"
            android:paddingHorizontal="2dp"
            android:layout_marginBottom="4dp"
            android:visibility="gone">
            <ImageView
                android:id="@+id/todo_item_checkbox_3"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_checkbox_unchecked"
                android:contentDescription="标记完成"
                android:clickable="false"
                android:focusable="false" />
            <TextView
                android:id="@+id/todo_item_title_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:textColor="@color/widget_text_primary"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end" />
            <ImageView
                android:id="@+id/todo_item_priority_3"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginLeft="6dp"
                android:src="@drawable/ic_checkbox_checked"
                android:visibility="gone" />
        </LinearLayout>

        <!-- More Hint Layout -->
        <LinearLayout
            android:id="@+id/todo_more_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp"
            android:layout_marginStart="4dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/todo_more_badge"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:background="@drawable/bg_widget_badge"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/todo_more_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="更多待办"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Empty State -->
    <TextView
        android:id="@+id/todo_empty_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="暂无今日待办"
        android:textColor="@color/widget_text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
