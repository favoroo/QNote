<?xml version="1.0" encoding="utf-8"?>
<!--
  快捷记录 · 1 格宽竖条（1×2 ～ 1×4）：竖向悬浮胶囊坞，同样只包住三颗正圆。
  三颗圆钮（44 / 40 / 40dp，间隔 8dp）整体在格子中居中；更高也不会被拉成一根长条，
  剩下的是透明点击热区。1×2 极矮时 provider 收起次级圆钮，只留主圆。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_quick_record_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:contentDescription="@string/widget_quick_record_action">

    <LinearLayout
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_widget_qr_pill"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp">

        <FrameLayout
            android:id="@+id/qr_tall_primary"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_widget_qr_solid_circle"
            android:contentDescription="@string/widget_quick_record_action">

            <ImageView
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_pen_accent" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/qr_tall_photo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_widget_qr_secondary_circle"
            android:contentDescription="选择相册图片">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_gallery_white" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/qr_tall_camera"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_widget_qr_secondary_circle"
            android:contentDescription="启动相机拍照">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_camera_white" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>