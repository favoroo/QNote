<?xml version="1.0" encoding="utf-8"?>
<!--
  快捷记录 · 1 格宽竖卡（1×2 ～ 1×4）：一条竖向胶囊，内容是竖向居中的一列圆钮。
  1 格只有约 60dp 宽，横排放不下第二颗按钮，所以次级按钮改为竖排；
  高度不够（1×2）时由 provider 收起次级按钮，只留白色主操作圆。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_quick_record_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_qr_pill"
    android:contentDescription="@string/widget_quick_record_action"
    android:gravity="center"
    android:orientation="vertical">

    <ImageButton
        android:id="@+id/qr_tall_primary"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_widget_qr_solid_circle"
        android:contentDescription="@string/widget_quick_record_action"
        android:padding="11dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_widget_pen_accent" />

    <ImageButton
        android:id="@+id/qr_tall_photo"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_widget_qr_scrim"
        android:contentDescription="选择相册图片"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_widget_gallery_white"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/qr_tall_camera"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_widget_qr_scrim"
        android:contentDescription="启动相机拍照"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_widget_camera_white"
        android:visibility="gone" />
</LinearLayout>