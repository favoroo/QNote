<?xml version="1.0" encoding="utf-8"?>
<!--
  快捷记录 · 窄高卡片（2×3、2×4）：28dp 圆角曜石黑卡片。
  2 列宽放不下「左大右双」，改为上大下小的三段式：
  96dp 白色主圆居中偏上，下方两颗 64dp 炭灰圆并排，整组纵向居中。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_quick_record_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_qr_card"
    android:contentDescription="@string/widget_quick_record_action"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="14dp"
    android:paddingEnd="14dp"
    android:paddingBottom="14dp">

    <FrameLayout
        android:id="@+id/qr_panel_primary"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:background="@drawable/bg_widget_qr_solid_circle"
        android:contentDescription="@string/widget_quick_record_action">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_pen_accent" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/qr_panel_photo"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_widget_qr_secondary_circle"
            android:contentDescription="选择相册图片">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_gallery_white" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/qr_panel_camera"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/bg_widget_qr_secondary_circle"
            android:contentDescription="启动相机拍照">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_camera_white" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>