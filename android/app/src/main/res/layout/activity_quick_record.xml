<?xml version="1.0" encoding="utf-8"?>
<!--
  快捷记录弹窗：与桌面快捷记录组件共用同一套「曜石黑 + 正圆」语言。
  底部一排四颗正圆：左侧相册 / 相机（次级操作），右侧取消 / 发送；
  发送用强调色实心圆做唯一彩色主操作，图标承担语义，不再出现文字按钮。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Main Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_quick_record_card"
        android:clickable="true"
        android:elevation="8dp"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="16dp">

        <!--
          统一输入区：固定高度，附着照片时弹窗尺寸不跳动。
          addStatesFromChildren 让容器跟随 EditText 的焦点态，整块输入区一起高亮。
        -->
        <LinearLayout
            android:id="@+id/layout_input_container"
            android:layout_width="match_parent"
            android:layout_height="144dp"
            android:addStatesFromChildren="true"
            android:background="@drawable/bg_quick_record_input"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Input Box -->
            <EditText
                android:id="@+id/edit_record_content"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@null"
                android:gravity="top|left"
                android:hint="记录一下"
                android:imeOptions="actionDone"
                android:inputType="textMultiLine"
                android:padding="2dp"
                android:scrollbars="vertical"
                android:textColor="@color/widget_qr_on_surface"
                android:textColorHint="@color/widget_text_secondary"
                android:textSize="15sp" />

            <!-- 已附照片预览（位于输入区底部） -->
            <HorizontalScrollView
                android:id="@+id/scroll_photos_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/container_photos_preview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- 底部操作栏：左侧选图工具，右侧取消 / 发送，中间弹性留白 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_dialog_photo"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_quick_record_tool_circle"
                android:contentDescription="选择相册图片"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_gallery_white" />

            <Space
                android:layout_width="8dp"
                android:layout_height="wrap_content" />

            <ImageButton
                android:id="@+id/btn_dialog_camera"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_quick_record_tool_circle"
                android:contentDescription="启动相机拍照"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_camera_white" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btn_dialog_cancel"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_quick_record_tool_circle"
                android:contentDescription="取消"
                android:padding="13dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_quick_record_close" />

            <Space
                android:layout_width="10dp"
                android:layout_height="wrap_content" />

            <ImageButton
                android:id="@+id/btn_dialog_send"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_quick_record_send_circle"
                android:contentDescription="发送记录"
                android:padding="11dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_quick_record_send" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
