<?xml version="1.0" encoding="utf-8"?>
<!--
  「问小Q」1×2 竖向胶囊：圆钮在上、标题在下。
  宽度只有一格，左右 padding 必须压到 4dp，否则 40dp 的窄格会把标题挤没；
  标题用 autoSize + 单行，宽度紧张时自动缩字而不是截断。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_ai_entry_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_ai_card"
    android:contentDescription="@string/widget_ai_open"
    android:gravity="center_horizontal|center_vertical"
    android:orientation="vertical"
    android:paddingLeft="4dp"
    android:paddingTop="8dp"
    android:paddingRight="4dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/ai_entry_icon"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_ai_button" />

    <TextView
        android:id="@+id/ai_entry_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:autoSizeMaxTextSize="12sp"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="sans-serif-rounded"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/widget_ai_label"
        android:textColor="@color/widget_text_primary"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
