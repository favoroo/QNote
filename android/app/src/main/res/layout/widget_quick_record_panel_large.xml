<?xml version="1.0" encoding="utf-8"?>
<!--
  快捷记录 · 4×3 / 4×4 大高卡片：28dp 圆角曜石黑卡片，「左大圆 + 右双圆」大号构图。
  4 列宽约 350dp：左侧 160dp 白圆，右侧两颗 92dp 炭灰圆纵向等距；
  全部正圆，大留白靠尺寸差与偏置撑住，不做整块拉长胶囊。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_quick_record_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_qr_card"
    android:contentDescription="@string/widget_quick_record_action"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="22dp"
    android:paddingTop="20dp"
    android:paddingEnd="22dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.25"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/qr_panel_primary"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:background="@drawable/bg_widget_qr_solid_circle"
            android:contentDescription="@string/widget_quick_record_action">

            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_pen_accent" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/qr_panel_photo"
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:background="@drawable/bg_widget_qr_secondary_circle"
            android:contentDescription="选择相册图片">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_gallery_white" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/qr_panel_camera"
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_widget_qr_secondary_circle"
            android:contentDescription="启动相机拍照">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_camera_white" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>