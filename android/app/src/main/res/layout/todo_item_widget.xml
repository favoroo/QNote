<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_widget_input"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="8dp">

    <!-- Checkbox ImageView -->
    <ImageView
        android:id="@+id/todo_item_checkbox"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_checkbox_unchecked"
        android:contentDescription="标记完成"
        android:clickable="false"
        android:focusable="false" />

    <!-- Todo Title -->
    <TextView
        android:id="@+id/todo_item_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:text="待办事项"
        android:textColor="@color/widget_text_primary"
        android:textSize="14sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <ImageView
        android:id="@+id/todo_item_priority"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginLeft="6dp"
        android:src="@drawable/ic_checkbox_checked"
        android:visibility="gone" />
</LinearLayout>
