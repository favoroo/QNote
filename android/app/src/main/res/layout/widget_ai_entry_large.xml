<?xml version="1.0" encoding="utf-8"?>
<!--
  「问小Q」2×2 完整卡片：圆钮 + 标题 + 一句轻量文案。
  图标区用 0dp + weight=1 吃掉标题之外的剩余高度，2×2 被拉得更大时圆钮跟着长大，
  不会出现「卡片变大、按钮还是 56dp」的空洞感。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_ai_entry_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_ai_card"
    android:contentDescription="@string/widget_ai_open"
    android:gravity="center_horizontal|center_vertical"
    android:orientation="vertical"
    android:padding="10dp">

    <ImageView
        android:id="@+id/ai_entry_icon"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_ai_button" />

    <TextView
        android:id="@+id/ai_entry_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:autoSizeMaxTextSize="16sp"
        android:autoSizeMinTextSize="10sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="sans-serif-rounded"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/widget_ai_label"
        android:textColor="@color/widget_text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ai_entry_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:autoSizeMaxTextSize="10sp"
        android:autoSizeMinTextSize="7sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/widget_ai_tagline"
        android:textColor="@color/widget_text_secondary"
        android:textSize="10sp" />
</LinearLayout>
