<?xml version="1.0" encoding="utf-8"?>
<!--
  快捷记录 · 2 列宽 1 行条（2×1）：黑胶囊容器 + 三颗紧凑正圆。
  2 列只有约 175dp，用 46 / 38 / 38dp 三颗正圆 + 6dp 间隙正好铺满一条；
  不再像大条那样隐藏次级按钮，避免「一个圆孤零零漂在长条里」。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_quick_record_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:contentDescription="@string/widget_quick_record_action">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_widget_qr_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:gravity="center"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/qr_bar_primary"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_widget_qr_solid_circle"
                android:contentDescription="@string/widget_quick_record_action">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_widget_pen_accent" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/qr_bar_photo"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_widget_qr_secondary_circle"
                android:contentDescription="选择相册图片">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_widget_gallery_white" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/qr_bar_camera"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_widget_qr_secondary_circle"
                android:contentDescription="启动相机拍照">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_widget_camera_white" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>