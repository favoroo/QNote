<?xml version="1.0" encoding="utf-8"?>
<!--
  快捷记录组件底板。与今日待办 / 问小Q 一样由组件自己画 background：
  launcher 只在根布局没有背景时才补默认灰板，缺了它会露出一块不属于 App 的灰色。
  渐变只取约 2% 的亮度差，深色桌面上不会变成发光色块；圆角 22dp 兼容 1 格到 4 格高度。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:angle="315"
        android:endColor="@color/widget_qr_surface_bottom"
        android:startColor="@color/widget_qr_surface_top"
        android:type="linear" />
    <corners android:radius="22dp" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_border" />
</shape>