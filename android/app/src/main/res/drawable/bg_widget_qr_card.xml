<?xml version="1.0" encoding="utf-8"?>
<!--
  快捷记录大尺寸圆角卡片底板：28dp 圆角深曜石黑 + 1dp 发丝描边，
  与内置胶囊钮的圆润折角呼应。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_qr_surface" />
    <corners android:radius="28dp" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_qr_border" />
</shape>
