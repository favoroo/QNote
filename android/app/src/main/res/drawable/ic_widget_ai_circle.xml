<?xml version="1.0" encoding="utf-8"?>
<!--
  「问小Q」桌面入口：极简曜石黑双层正圆 + 负空间断口几何白色「Q」。

  设计说明：
  - 外层曜石黑正圆（r=47/54，占画布短边 ~87%）+ 1 单位发丝描边，
    四周预留均匀呼吸边距：1×1 格下约 58~62dp（与系统图标及快捷记录 1×1 对齐），
    2×2 格下等比放大且不顶死边缘；2×1 / 1×2 下依然稳居正中为正圆。
  - 内部托起一层低调的深炭灰同心圆盘（不加刺眼白描边），
    在深色壁纸与大尺寸下提供细腻的物理按键层级，远看仍保持纯粹黑色圆形。
  - 居中柔白字母「Q」主体向左上微调 (-1.0, -1.2) 抵消右下角尾巴的视觉下坠，
    右下采用 29° 呼吸断口配合圆头斜向胶囊尾，兼顾小尺寸清晰度与大尺寸设计感。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 外层曜石黑实心圆底板 -->
    <path
        android:fillColor="@color/widget_ai_circle"
        android:pathData="M54,7 A47,47 0 1 0 54,101 A47,47 0 1 0 54,7 Z" />

    <!-- 外缘发丝高光描边（中心 r=46.5、线宽 1，外缘恰好贴合底板，纯黑壁纸下轮廓清晰） -->
    <path
        android:pathData="M54,7.5 A46.5,46.5 0 1 0 54,100.5 A46.5,46.5 0 1 0 54,7.5 Z"
        android:strokeWidth="1"
        android:strokeColor="@color/widget_ai_border" />

    <!-- 内层深炭灰同心圆盘（无硬描边，靠微弱明度差承托中心 Q） -->
    <path
        android:fillColor="@color/widget_ai_inner_disc"
        android:pathData="M54,19 A35,35 0 1 0 54,89 A35,35 0 1 0 54,19 Z" />

    <!-- 白色字母 Q 主环（中心 (53.0, 52.8)，半径 16.6，顺时针 74° -> 16°，右下留出 58° 负空间断口） -->
    <path
        android:pathData="M57.58,68.76 A16.6,16.6 0 1 1 68.96,57.38"
        android:strokeWidth="6.4"
        android:strokeColor="@color/widget_ai_glyph"
        android:strokeLineCap="round" />

    <!-- 白色字母 Q 右下斜向胶囊尾（沿 45° 穿过断口，视觉重心与主环平衡） -->
    <path
        android:pathData="M58.16,57.96 L69.40,69.20"
        android:strokeWidth="6.4"
        android:strokeColor="@color/widget_ai_glyph"
        android:strokeLineCap="round" />
</vector>
