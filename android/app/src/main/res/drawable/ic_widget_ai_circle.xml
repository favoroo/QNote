<?xml version="1.0" encoding="utf-8"?>
<!--
  「问小Q」桌面入口：整个组件就是一颗实心圆形按钮，内部是扁平线稿小Q，没有文字。

  为什么整颗圆画进矢量而不是用 shape 背景：格子比例不一定是正方形（2×1 / 1×2 / 2×2），
  shape 背景会被拉伸成椭圆；矢量配合 ImageView 的 centerInside，圆始终是正圆、
  直径跟随格子短边等比放大，透明区域仍属于点击热区。

  机器人几何沿用 lib/widgets/ai/q_avatar.dart 的线稿（QIcon outlined）母版：
  天线球 + 圆角头盔 + 胶囊眼，描边外缘与母版机身对齐，保证桌面与 App 内是同一只小Q。
  纯色平涂、无渐变无内高光，小尺寸下边缘更干净。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 实心圆底：铺满画布，作为组件唯一底板 -->
    <path
        android:fillColor="@color/widget_ai_circle"
        android:pathData="M54,0 A54,54 0 1 0 54,108 A54,54 0 1 0 54,0 Z" />

    <!-- 小Q 线稿（母版 205×206，缩至圆的约 57% 并居中） -->
    <group
        android:scaleX="0.30"
        android:scaleY="0.30"
        android:translateX="23.25"
        android:translateY="23.1">

        <!-- 天线球 -->
        <path
            android:fillColor="@color/widget_ai_robot"
            android:pathData="M101.5,0.5 A15.5,15.5 0 1 0 101.5,31.5 A15.5,15.5 0 1 0 101.5,0.5 Z" />

        <!-- 天线杆：宽度与描边一致，上端被天线球盖住 -->
        <path
            android:fillColor="@color/widget_ai_robot"
            android:pathData="M91.5,16 L111.5,16 L111.5,68 L91.5,68 Z" />

        <!--
          圆角头盔：用 evenOdd 填充「外缘圆角矩形 + 内缘圆角矩形」直接画出描边效果。
          vector 不支持 strokeJoin（那是 shape 的属性），stroke 默认 miter 会在圆角处留尖角；
          内缘圆角取 38-20=18，与 20 宽的描边内缩后完全一致。
        -->
        <path
            android:fillColor="@color/widget_ai_robot"
            android:fillType="evenOdd"
            android:pathData="M38,58 L165,58 A38,38 0 0 1 203,96 L203,167 A38,38 0 0 1 165,205 L38,205 A38,38 0 0 1 0,167 L0,96 A38,38 0 0 1 38,58 Z M38,78 L165,78 A18,18 0 0 1 183,96 L183,167 A18,18 0 0 1 165,185 L38,185 A18,18 0 0 1 20,167 L20,96 A18,18 0 0 1 38,78 Z" />

        <!-- 左眼（竖向胶囊） -->
        <path
            android:fillColor="@color/widget_ai_robot"
            android:pathData="M60.5,126.5 A10,10 0 0 1 80.5,126.5 L80.5,136.5 A10,10 0 0 1 60.5,136.5 Z" />

        <!-- 右眼（竖向胶囊） -->
        <path
            android:fillColor="@color/widget_ai_robot"
            android:pathData="M122.5,126.5 A10,10 0 0 1 142.5,126.5 L142.5,136.5 A10,10 0 0 1 122.5,136.5 Z" />
    </group>
</vector>
