<?xml version="1.0" encoding="utf-8"?>
<!-- 输入区常态：不透明炭黑表面，比卡片略亮一层，配 1dp 发丝描边勾出边界。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_qr_input_bg" />
    <corners android:radius="18dp" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_qr_input_border" />
</shape>
