<?xml version="1.0" encoding="utf-8"?>
<!--
  快捷记录组件极简黑底胶囊：深曜石黑 + 1dp 微亮发丝描边，
  radius 取 999dp 随胶囊自身固定高度自动贴合为真胶囊。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/widget_qr_surface" />
    <corners android:radius="999dp" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_qr_border" />
</shape>
