<?xml version="1.0" encoding="utf-8"?>
<!--
  「问小Q」多尺寸卡片底板：22dp 圆角在 1×2/2×1 的窄边上会自然收成胶囊，
  在 2×2 上是圆角方卡，一套 drawable 覆盖三种比例，避免为每个尺寸复制样式。
  竖向渐变只做极轻的蓝调，让纯白卡片不显死板，主视觉仍留给圆形按钮。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:angle="270"
        android:endColor="@color/widget_ai_card_bottom"
        android:startColor="@color/widget_ai_card_top" />
    <corners android:radius="22dp" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_ai_card_stroke" />
</shape>
