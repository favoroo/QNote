<?xml version="1.0" encoding="utf-8"?>
<!--
  弹窗次级操作正圆底（相册 / 相机 / 取消）：与桌面组件次级圆钮同一套炭灰 + 发丝描边，
  固定宽高下永远是正圆；表面不透明，ripple 只在点按时出现。
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/widget_qr_ripple">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/widget_qr_dialog_tool_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/widget_qr_tile_border" />
        </shape>
    </item>
</ripple>
