<?xml version="1.0" encoding="utf-8"?>
<!--
  放行本机回环明文，其余流量仍受默认策略约束（targetSdk 28+ 默认禁止明文 HTTP）。

  为什么需要这个文件：just_audio 的 StreamAudioSource（小Q朗读播放内存里的
  mp3 字节）在 Android/iOS 上通过监听 127.0.0.1 的本地 HTTP 代理供播放器取流，
  明文被系统拦截后 ExoPlayer 只会记录错误、不让 play() 抛异常，
  表现为"点朗读完全无声，也没有任何报错"。
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
